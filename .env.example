# Copia este archivo como .env y llena las claves.

# Client ID de tu app en https://developer.spotify.com/dashboard
# Redirect URI que debes registrar allá: http://127.0.0.1:8888/callback
SPOTIFY_CLIENT_ID=

# Clave gratis de https://aistudio.google.com/apikey (IA principal)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Modelos de respaldo si el principal está saturado (separados por comas)
GEMINI_FALLBACKS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Opcional: clave de https://platform.claude.com (respaldo si Gemini llega al límite)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

PORT=8888
